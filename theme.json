{
    "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
    "name": "ArtisanPack UI",
    "slug": "artisanpack-ui",
    "version": "0.1.4",
    "description": "Atmospheric, dark-first marketing theme for JMWD Keystone. Neon triad (blue / cyan / magenta) over deep space-black grounds with one gradient moment per view. Ships blog, packages, and a rich pattern library.",
    "author": "Jacob Martella",
    "screenshot": "screenshot.png",
    "requires": "2.0.0",
    "update": {
        "github": "ArtisanPack-UI/artisanpack-ui-website-theme"
    },

    "settings": {
        "appearanceTools": true,
        "color": {
            "custom": true,
            "customGradient": true,
            "palette": [
                { "slug": "primary",        "name": "Primary",        "color": "#2962FF" },
                { "slug": "secondary",      "name": "Secondary",      "color": "#00E5FF" },
                { "slug": "accent",         "name": "Accent",         "color": "#E040FB" },
                { "slug": "primary-tint",   "name": "Primary Tint",   "color": "color-mix(in srgb, var(--wp--preset--color--primary) 18%, transparent)" },
                { "slug": "primary-text",   "name": "Primary Text",   "color": "#7A9DFF" },
                { "slug": "secondary-tint", "name": "Secondary Tint", "color": "color-mix(in srgb, var(--wp--preset--color--secondary) 18%, transparent)" },
                { "slug": "accent-tint",    "name": "Accent Tint",    "color": "color-mix(in srgb, var(--wp--preset--color--accent) 20%, transparent)" },
                { "slug": "on-primary",     "name": "On Primary",     "color": "#FFFFFF" },
                { "slug": "on-secondary",   "name": "On Secondary",   "color": "#0B1120" },
                { "slug": "on-accent",      "name": "On Accent",      "color": "#0B1120" },
                { "slug": "on-gradient",    "name": "On Gradient",    "color": "#000000" },
                { "slug": "on-media",       "name": "On Media",       "color": "rgba(255, 255, 255, 0.82)" },
                { "slug": "on-neon",        "name": "On Neon",        "color": "#0B1120" },
                { "slug": "base",           "name": "Base",           "color": "#111827" },
                { "slug": "section",        "name": "Section",        "color": "#1F2937" },
                { "slug": "surface",        "name": "Surface",        "color": "#1F2937" },
                { "slug": "surface-2",      "name": "Surface 2",      "color": "#111827" },
                { "slug": "ink",            "name": "Ink",            "color": "#0B1120" },
                { "slug": "text",           "name": "Text",           "color": "#FFFFFF" },
                { "slug": "text-muted",     "name": "Text Muted",     "color": "#9CA3AF" },
                { "slug": "text-subtle",    "name": "Text Subtle",    "color": "#6B7280" },
                { "slug": "text-invert",    "name": "Text Invert",    "color": "#111827" },
                { "slug": "text-link",      "name": "Text Link",      "color": "#00E5FF" },
                { "slug": "border",         "name": "Border",         "color": "#374151" },
                { "slug": "border-subtle",  "name": "Border Subtle",  "color": "#263143" },
                { "slug": "border-strong",  "name": "Border Strong",  "color": "#4B5563" },
                { "slug": "white",          "name": "White",          "color": "#FFFFFF" },
                { "slug": "neutral-0",      "name": "Neutral 0",      "color": "#F9FAFB" },
                { "slug": "neutral-1",      "name": "Neutral 1",      "color": "#F3F4F6" },
                { "slug": "neutral-2",      "name": "Neutral 2",      "color": "#E5E7EB" },
                { "slug": "neutral-3",      "name": "Neutral 3",      "color": "#D1D5DB" },
                { "slug": "neutral-4",      "name": "Neutral 4",      "color": "#9CA3AF" },
                { "slug": "neutral-5",      "name": "Neutral 5",      "color": "#6B7280" },
                { "slug": "neutral-6",      "name": "Neutral 6",      "color": "#4B5563" },
                { "slug": "neutral-7",      "name": "Neutral 7",      "color": "#374151" },
                { "slug": "neutral-8",      "name": "Neutral 8",      "color": "#1F2937" },
                { "slug": "neutral-9",      "name": "Neutral 9",      "color": "#111827" },
                { "slug": "success",        "name": "Success",        "color": "#22C55E" },
                { "slug": "danger",         "name": "Danger",         "color": "#EF4444" },
                { "slug": "warning",        "name": "Warning",        "color": "#F59E0B" },
                { "slug": "info",           "name": "Info",           "color": "#2962FF" }
            ],
            "gradients": [
                { "slug": "brand",             "name": "Brand (primary → accent)",  "gradient": "linear-gradient(115deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--accent) 100%)" },
                { "slug": "brand-card",        "name": "Brand (featured card)",     "gradient": "linear-gradient(115deg, color-mix(in srgb, var(--wp--preset--color--primary) 88%, #000000) 0%, color-mix(in srgb, var(--wp--preset--color--accent) 70%, #000000) 100%)" },
                { "slug": "brand-button",      "name": "Brand (buttons)",           "gradient": "linear-gradient(115deg, color-mix(in srgb, var(--wp--preset--color--primary) 94%, #FFFFFF) 0%, var(--wp--preset--color--accent) 100%)" },
                { "slug": "neon",              "name": "Neon (three-stop)",         "gradient": "linear-gradient(115deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--secondary) 55%, var(--wp--preset--color--accent) 100%)" },
                { "slug": "primary-secondary", "name": "Primary → Secondary",       "gradient": "linear-gradient(115deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--secondary) 100%)" },
                { "slug": "primary-accent",    "name": "Primary → Accent",          "gradient": "linear-gradient(115deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--accent) 100%)" },
                { "slug": "secondary-primary", "name": "Secondary → Primary",       "gradient": "linear-gradient(115deg, var(--wp--preset--color--secondary) 0%, var(--wp--preset--color--primary) 100%)" },
                { "slug": "secondary-accent",  "name": "Secondary → Accent",        "gradient": "linear-gradient(115deg, var(--wp--preset--color--secondary) 0%, var(--wp--preset--color--accent) 100%)" },
                { "slug": "accent-primary",    "name": "Accent → Primary",          "gradient": "linear-gradient(115deg, var(--wp--preset--color--accent) 0%, var(--wp--preset--color--primary) 100%)" },
                { "slug": "accent-secondary",  "name": "Accent → Secondary",        "gradient": "linear-gradient(115deg, var(--wp--preset--color--accent) 0%, var(--wp--preset--color--secondary) 100%)" },
                { "slug": "starfield",         "name": "Starfield (on ink)",        "gradient": "radial-gradient(1.5px 1.5px at 20% 30%, rgba(255,255,255,0.55), transparent 60%), radial-gradient(1.5px 1.5px at 75% 15%, rgba(255,255,255,0.40), transparent 60%), radial-gradient(1px 1px at 40% 70%, rgba(255,255,255,0.45), transparent 60%), radial-gradient(1px 1px at 88% 55%, rgba(0,229,255,0.55), transparent 60%), radial-gradient(1.5px 1.5px at 60% 85%, rgba(255,255,255,0.35), transparent 60%), radial-gradient(1px 1px at 10% 80%, rgba(224,64,251,0.50), transparent 60%), radial-gradient(1px 1px at 50% 45%, rgba(255,255,255,0.30), transparent 60%), var(--wp--preset--color--ink)" },
                { "slug": "aurora",            "name": "Aurora (on base)",          "gradient": "radial-gradient(55% 48% at 86% -13%, color-mix(in srgb, var(--wp--preset--color--accent) 30%, transparent), transparent 100%), radial-gradient(62% 45% at 8% -20%, color-mix(in srgb, var(--wp--preset--color--primary) 32%, transparent), transparent 100%), radial-gradient(48% 37% at 56% 1%, color-mix(in srgb, var(--wp--preset--color--secondary) 21%, transparent), transparent 100%), var(--wp--preset--color--base)" },
                { "slug": "media-placeholder", "name": "Media placeholder",         "gradient": "linear-gradient(135deg, color-mix(in srgb, var(--wp--preset--color--primary) 55%, transparent), color-mix(in srgb, var(--wp--preset--color--accent) 55%, transparent)), var(--wp--preset--color--surface-2)" },
                { "slug": "starfield-glow", "name": "Starfield + glow (on ink)", "gradient": "radial-gradient(90% 70% at 50% -10%, color-mix(in srgb, var(--wp--preset--color--primary) 22%, transparent), transparent 60%), radial-gradient(70% 60% at 80% 110%, color-mix(in srgb, var(--wp--preset--color--accent) 18%, transparent), transparent 60%), radial-gradient(1.5px 1.5px at 20% 30%, rgba(255,255,255,0.55), transparent 60%), radial-gradient(1.5px 1.5px at 75% 15%, rgba(255,255,255,0.40), transparent 60%), radial-gradient(1px 1px at 40% 70%, rgba(255,255,255,0.45), transparent 60%), radial-gradient(1px 1px at 88% 55%, rgba(0,229,255,0.55), transparent 60%), radial-gradient(1.5px 1.5px at 60% 85%, rgba(255,255,255,0.35), transparent 60%), radial-gradient(1px 1px at 10% 80%, rgba(224,64,251,0.50), transparent 60%), radial-gradient(1px 1px at 50% 45%, rgba(255,255,255,0.30), transparent 60%), var(--wp--preset--color--ink)" },
                { "slug": "wash-corners", "name": "Corner washes (on base)", "gradient": "radial-gradient(70% 60% at 100% 0%, color-mix(in srgb, var(--wp--preset--color--accent) 12%, transparent), transparent 55%), radial-gradient(70% 60% at 0% 100%, color-mix(in srgb, var(--wp--preset--color--primary) 12%, transparent), transparent 55%), var(--wp--preset--color--base)" },
                { "slug": "wash-diagonal", "name": "Diagonal washes (on ink)", "gradient": "radial-gradient(70% 70% at 0% 0%, color-mix(in srgb, var(--wp--preset--color--primary) 18%, transparent), transparent 55%), radial-gradient(70% 70% at 100% 100%, color-mix(in srgb, var(--wp--preset--color--accent) 16%, transparent), transparent 55%), var(--wp--preset--color--ink)" },
                { "slug": "neon-glow", "name": "Neon + highlight", "gradient": "radial-gradient(80% 120% at 50% -10%, rgba(255,255,255,0.18), transparent 60%), var(--wp--preset--gradient--neon)" },
                { "slug": "neon-gloss", "name": "Neon + gloss (CTA panel)", "gradient": "radial-gradient(80% 120% at 50% -20%, rgba(255,255,255,0.22), transparent 60%), var(--wp--preset--gradient--neon)" },
                { "slug": "starfield-wash", "name": "Starfield + top wash (CTA)", "gradient": "radial-gradient(80% 70% at 50% -10%, color-mix(in srgb, var(--wp--preset--color--primary) 20%, transparent), transparent 60%), radial-gradient(1.5px 1.5px at 20% 30%, rgba(255,255,255,0.55), transparent 60%), radial-gradient(1.5px 1.5px at 75% 15%, rgba(255,255,255,0.40), transparent 60%), radial-gradient(1px 1px at 40% 70%, rgba(255,255,255,0.45), transparent 60%), radial-gradient(1px 1px at 88% 55%, rgba(0,229,255,0.55), transparent 60%), radial-gradient(1.5px 1.5px at 60% 85%, rgba(255,255,255,0.35), transparent 60%), radial-gradient(1px 1px at 10% 80%, rgba(224,64,251,0.50), transparent 60%), radial-gradient(1px 1px at 50% 45%, rgba(255,255,255,0.30), transparent 60%), var(--wp--preset--color--ink)" }
            ]
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                { "slug": "glow-primary",      "name": "Glow · Primary",        "shadow": "0 0 24px color-mix(in srgb, var(--wp--preset--color--primary) 50%, transparent)" },
                { "slug": "glow-secondary",    "name": "Glow · Secondary",      "shadow": "0 0 24px color-mix(in srgb, var(--wp--preset--color--secondary) 55%, transparent)" },
                { "slug": "glow-accent",       "name": "Glow · Accent",         "shadow": "0 0 24px color-mix(in srgb, var(--wp--preset--color--accent) 55%, transparent)" },
                { "slug": "glow-primary-lg",   "name": "Glow · Primary (lg)",   "shadow": "0 0 48px color-mix(in srgb, var(--wp--preset--color--primary) 45%, transparent)" },
                { "slug": "glow-secondary-lg", "name": "Glow · Secondary (lg)", "shadow": "0 0 48px color-mix(in srgb, var(--wp--preset--color--secondary) 45%, transparent)" },
                { "slug": "glow-accent-lg",    "name": "Glow · Accent (lg)",    "shadow": "0 0 48px color-mix(in srgb, var(--wp--preset--color--accent) 45%, transparent)" },
                { "slug": "glow-gradient",     "name": "Glow · Gradient",       "shadow": "0 0 20px color-mix(in srgb, var(--wp--preset--color--primary) 45%, transparent), 0 0 34px color-mix(in srgb, var(--wp--preset--color--accent) 40%, transparent)" },
                { "slug": "ring-primary",      "name": "Ring · Primary",        "shadow": "0 0 0 2px var(--wp--preset--color--surface), 0 0 0 4px var(--wp--preset--color--primary)" },
                { "slug": "sm",                "name": "Small",                 "shadow": "0 1px 3px 0 rgba(0,0,0,0.35), 0 1px 2px -1px rgba(0,0,0,0.30)" },
                { "slug": "md",                "name": "Medium",                "shadow": "0 6px 18px 0 rgba(0,0,0,0.40)" },
                { "slug": "lg",                "name": "Large",                 "shadow": "0 14px 40px 0 rgba(0,0,0,0.45)" },
                { "slug": "xl",                "name": "X-Large",               "shadow": "0 24px 60px 0 rgba(0,0,0,0.50)" },
                { "slug": "panel",             "name": "Panel",                 "shadow": "0 10px 50px 0 rgba(0,0,0,0.35)" }
            ]
        },
        "typography": {
            "customFontSize": true,
            "lineHeight": true,
            "letterSpacing": true,
            "textTransform": true,
            "fontStyle": true,
            "fontWeight": true,
            "fontFamilies": [
                {
                    "slug": "sans",
                    "name": "Sans (Poppins)",
                    "fontFamily": "Poppins, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
                    "fontFace": [
                        { "fontFamily": "Poppins", "fontStyle": "normal", "fontWeight": "300", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-300.woff2"] },
                        { "fontFamily": "Poppins", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-400.woff2"] },
                        { "fontFamily": "Poppins", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-400-italic.woff2"] },
                        { "fontFamily": "Poppins", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-500.woff2"] },
                        { "fontFamily": "Poppins", "fontStyle": "italic", "fontWeight": "500", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-500-italic.woff2"] },
                        { "fontFamily": "Poppins", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-600.woff2"] },
                        { "fontFamily": "Poppins", "fontStyle": "italic", "fontWeight": "600", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-600-italic.woff2"] },
                        { "fontFamily": "Poppins", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-700.woff2"] },
                        { "fontFamily": "Poppins", "fontStyle": "normal", "fontWeight": "800", "fontDisplay": "swap", "src": ["file:./assets/fonts/poppins-800.woff2"] }
                    ]
                },
                { "slug": "display", "name": "Display (Poppins)", "fontFamily": "Poppins, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
                {
                    "slug": "mono",
                    "name": "Mono (Space Mono)",
                    "fontFamily": "'Space Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
                    "fontFace": [
                        { "fontFamily": "Space Mono", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/space-mono-400.woff2"] },
                        { "fontFamily": "Space Mono", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/space-mono-400-italic.woff2"] },
                        { "fontFamily": "Space Mono", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": ["file:./assets/fonts/space-mono-700.woff2"] },
                        { "fontFamily": "Space Mono", "fontStyle": "italic", "fontWeight": "700", "fontDisplay": "swap", "src": ["file:./assets/fonts/space-mono-700-italic.woff2"] }
                    ]
                }
            ],
            "fontSizes": [
                { "slug": "xsmall",     "name": "X-Small",     "size": "0.8125rem" },
                { "slug": "eyebrow",    "name": "Eyebrow",     "size": "0.8125rem" },
                { "slug": "small",      "name": "Small",       "size": "0.875rem" },
                { "slug": "button",     "name": "Button",      "size": "0.9375rem" },
                { "slug": "body-sm",    "name": "Body (sm)",   "size": "0.9375rem" },
                { "slug": "body",       "name": "Body",        "size": "1rem" },
                { "slug": "button-lg",  "name": "Button (lg)", "size": "1.0625rem" },
                { "slug": "lead",       "name": "Lead",        "size": "1.125rem" },
                { "slug": "h6",         "name": "H6",          "size": "clamp(1.0625rem, 1.0341rem + 0.1212vw, 1.125rem)" },
                { "slug": "review",     "name": "Review",      "size": "1.1875rem" },
                { "slug": "card-title", "name": "Card title",  "size": "1.3125rem" },
                { "slug": "h5",         "name": "H5",          "size": "clamp(1.25rem, 1.1932rem + 0.2424vw, 1.375rem)" },
                { "slug": "blockquote", "name": "Blockquote",  "size": "clamp(1.25rem, 1.1932rem + 0.2424vw, 1.375rem)" },
                { "slug": "h4",         "name": "H4",          "size": "clamp(1.5rem, 1.3864rem + 0.4848vw, 1.75rem)" },
                { "slug": "h3",         "name": "H3",          "size": "clamp(1.75rem, 1.5227rem + 0.9697vw, 2.25rem)" },
                { "slug": "spotlight",  "name": "Spotlight",   "size": "clamp(1.75rem, 3.4vw, 2.5rem)" },
                { "slug": "h2",         "name": "H2",          "size": "clamp(2.125rem, 1.8409rem + 1.2121vw, 2.75rem)" },
                { "slug": "stat",       "name": "Stat",        "size": "2.75rem" },
                { "slug": "price",      "name": "Price",       "size": "3.25rem" },
                { "slug": "h1",         "name": "H1",          "size": "clamp(2.5rem, 2.0455rem + 1.9394vw, 3.5rem)" },
                { "slug": "display",    "name": "Display",     "size": "clamp(3.25rem, 7vw, 5.5rem)" }
            ]
        },
        "spacing": {
            "spacingSizes": [
                { "slug": "0",         "name": "None",       "size": "0"       },
                { "slug": "20",        "name": "2X-Small",   "size": "0.25rem" },
                { "slug": "30",        "name": "X-Small",    "size": "0.5rem"  },
                { "slug": "40",        "name": "Small",      "size": "1rem"    },
                { "slug": "50",        "name": "Medium",     "size": "1.5rem"  },
                { "slug": "60",        "name": "Large",      "size": "2rem"    },
                { "slug": "70",        "name": "X-Large",    "size": "3rem"    },
                { "slug": "80",        "name": "2X-Large",   "size": "4rem"    },
                { "slug": "90",        "name": "3X-Large",   "size": "6rem"    },
                { "slug": "100",       "name": "4X-Large",   "size": "7.5rem"  },
                { "slug": "grid",      "name": "Grid gap",   "size": "1.375rem" },
                { "slug": "gutter",    "name": "Gutter",     "size": "1.5rem"   },
                { "slug": "title-gap", "name": "Title gap",  "size": "3.5rem"   },
                { "slug": "section",   "name": "Section",    "size": "clamp(4.5rem, 3.1364rem + 5.8182vw, 7.5rem)" }
            ],
            "customSpacingSize": true,
            "padding": true,
            "margin": true,
            "blockGap": true,
            "units": ["px", "em", "rem", "vh", "vw", "%"]
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "layout": {
            "contentSize": "760px",
            "wideSize": "1200px"
        },
        "custom": {
            "box": { "radius": "12px", "border": "3px" },
            "radius": { "btn": "5px", "field": "5px", "tile": "14px", "panel": "20px", "pill": "999px" },
            "motion": { "ease": "cubic-bezier(0.16, 1, 0.3, 1)", "dur": "220ms", "durFast": "120ms" },
            "animation": { "glowColor": "color-mix(in srgb, var(--wp--preset--color--primary) 50%, transparent)" }
        }
    },

    "styles": {
        "color": {
            "background": "var:preset|color|base",
            "text":       "var:preset|color|text"
        },
        "typography": {
            "fontFamily": "var:preset|font-family|sans",
            "fontSize":   "var:preset|font-size|body",
            "lineHeight": "1.65"
        },
        "spacing": {
            "blockGap": "1.5rem"
        },
        "elements": {
            "heading": {
                "color": { "text": "var:preset|color|text" },
                "typography": { "fontFamily": "var:preset|font-family|display" }
            },
            "h1": {
                "typography": { "fontSize": "var:preset|font-size|h1", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.02em" }
            },
            "h2": {
                "typography": { "fontSize": "var:preset|font-size|h2", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.02em" }
            },
            "h3": {
                "typography": { "fontSize": "var:preset|font-size|h3", "fontWeight": "600", "lineHeight": "1.35", "letterSpacing": "-0.01em" }
            },
            "h4": {
                "typography": { "fontSize": "var:preset|font-size|h4", "fontWeight": "600", "lineHeight": "1.35", "letterSpacing": "-0.01em" }
            },
            "h5": {
                "typography": { "fontSize": "var:preset|font-size|h5", "fontWeight": "600", "lineHeight": "1.35", "letterSpacing": "0" }
            },
            "h6": {
                "typography": { "fontSize": "var:preset|font-size|h6", "fontWeight": "500", "lineHeight": "1.35", "letterSpacing": "0" }
            },
            "button": {
                "color": {
                    "gradient": "var:preset|gradient|brand-button",
                    "text":     "var:preset|color|on-gradient"
                },
                "border": { "width": "0", "style": "none", "radius": "5px" },
                "shadow": "var:preset|shadow|sm",
                "typography": {
                    "fontFamily":    "var:preset|font-family|sans",
                    "fontSize":      "var:preset|font-size|button",
                    "fontWeight":    "600",
                    "lineHeight":    "1",
                    "letterSpacing": "0.01em"
                },
                "spacing": {
                    "padding": { "top": "0.8125rem", "bottom": "0.8125rem", "left": "1.125rem", "right": "1.125rem" }
                },
                ":hover": {
                    "shadow": "var:preset|shadow|md"
                },
                ":focus-visible": {
                    "outline": { "color": "var:preset|color|secondary", "offset": "2px", "style": "solid", "width": "2px" }
                }
            },
            "link": {
                "color": { "text": "var:preset|color|text-link" },
                ":hover": { "color": { "text": "var:preset|color|text" } },
                ":focus-visible": {
                    "outline": { "color": "var:preset|color|secondary", "offset": "2px", "style": "solid", "width": "2px" }
                }
            },
            "caption": {
                "color": { "text": "var:preset|color|text-muted" },
                "typography": { "fontSize": "var:preset|font-size|small" }
            },
            "cite": {
                "color": { "text": "var:preset|color|text-muted" },
                "typography": { "fontSize": "var:preset|font-size|small", "fontStyle": "normal" }
            }
        },
        "blocks": {
            "artisanpack/quote": {
                "spacing": { "margin": { "left": "0", "right": "0" } },
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize":   "var:preset|font-size|blockquote",
                    "fontStyle":  "normal",
                    "fontWeight": "500",
                    "lineHeight": "1.45"
                }
            },
            "artisanpack/card": {
                "color": { "background": "var:preset|color|surface" },
