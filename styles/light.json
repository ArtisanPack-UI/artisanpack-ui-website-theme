{
    "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
    "version": 3,
    "title": "Light",

    "settings": {
        "color": {
            "palette": [
                { "slug": "primary",        "name": "Primary",        "color": "#1A237E" },
                { "slug": "secondary",      "name": "Secondary",      "color": "#00838F" },
                { "slug": "accent",         "name": "Accent",         "color": "#8E24AA" },
                { "slug": "primary-tint",   "name": "Primary Tint",   "color": "color-mix(in srgb, var(--wp--preset--color--primary) 18%, transparent)" },
                { "slug": "secondary-tint", "name": "Secondary Tint", "color": "color-mix(in srgb, var(--wp--preset--color--secondary) 18%, transparent)" },
                { "slug": "accent-tint",    "name": "Accent Tint",    "color": "color-mix(in srgb, var(--wp--preset--color--accent) 20%, transparent)" },
                { "slug": "on-primary",     "name": "On Primary",     "color": "#FFFFFF" },
                { "slug": "on-secondary",   "name": "On Secondary",   "color": "#FFFFFF" },
                { "slug": "on-accent",      "name": "On Accent",      "color": "#FFFFFF" },
                { "slug": "on-gradient",    "name": "On Gradient",    "color": "#FFFFFF" },
                { "slug": "base",           "name": "Base",           "color": "#F9FAFB" },
                { "slug": "section",        "name": "Section",        "color": "#FFFFFF" },
                { "slug": "surface",        "name": "Surface",        "color": "#FFFFFF" },
                { "slug": "surface-2",      "name": "Surface 2",      "color": "#F9FAFB" },
                { "slug": "ink",            "name": "Ink",            "color": "#0B1120" },
                { "slug": "text",           "name": "Text",           "color": "#000000" },
                { "slug": "text-muted",     "name": "Text Muted",     "color": "#4B5563" },
                { "slug": "text-subtle",    "name": "Text Subtle",    "color": "#9CA3AF" },
                { "slug": "text-invert",    "name": "Text Invert",    "color": "#FFFFFF" },
                { "slug": "text-link",      "name": "Text Link",      "color": "#00838F" },
                { "slug": "border",         "name": "Border",         "color": "#E5E7EB" },
                { "slug": "border-subtle",  "name": "Border Subtle",  "color": "#EEF1F5" },
                { "slug": "border-strong",  "name": "Border Strong",  "color": "#D1D5DB" },
                { "slug": "white",          "name": "White",          "color": "#FFFFFF" },
                { "slug": "neutral-0",      "name": "Neutral 0",      "color": "#F9FAFB" },
                { "slug": "neutral-1",      "name": "Neutral 1",      "color": "#F3F4F6" },
                { "slug": "neutral-2",      "name": "Neutral 2",      "color": "#E5E7EB" },
                { "slug": "neutral-3",      "name": "Neutral 3",      "color": "#D1D5DB" },
                { "slug": "neutral-4",      "name": "Neutral 4",      "color": "#9CA3AF" },
                { "slug": "neutral-5",      "name": "Neutral 5",      "color": "#6B7280" },
                { "slug": "neutral-6",      "name": "Neutral 6",      "color": "#4B5563" },
                { "slug": "neutral-7",      "name": "Neutral 7",      "color": "#374151" },
                { "slug": "neutral-8",      "name": "Neutral 8",      "color": "#1F2937" },
                { "slug": "neutral-9",      "name": "Neutral 9",      "color": "#111827" },
                { "slug": "success",        "name": "Success",        "color": "#22C55E" },
                { "slug": "danger",         "name": "Danger",         "color": "#EF4444" },
                { "slug": "warning",        "name": "Warning",        "color": "#F59E0B" },
                { "slug": "info",           "name": "Info",           "color": "#2962FF" }
            ]
        }
    },

    "styles": {
        "color": {
            "background": "var:preset|color|base",
            "text":       "var:preset|color|text"
        }
